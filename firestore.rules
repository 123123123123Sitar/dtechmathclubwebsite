rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isGrader() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isGrader == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) &&
        request.resource.data.isAdmin == false &&
        request.resource.data.isGrader == false);
      allow update: if isAdmin() || (isOwner(userId) &&
        request.resource.data.isAdmin == resource.data.isAdmin &&
        request.resource.data.isGrader == resource.data.isGrader);
      allow delete: if isAdmin();
    }

    match /siteProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) &&
        request.resource.data.accountType in ['student', 'coach']);
      allow update: if isAdmin() || (isOwner(userId) &&
        request.resource.data.accountType == resource.data.accountType);
      allow delete: if isAdmin();
    }

    match /coachAccounts/{coachId} {
      allow read, write: if isOwner(coachId) || isAdmin();
    }

    match /dpotdRegistrations/{userId} {
      allow read, create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /sponsorshipInquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /puzzleNightRegistrations/{registrationId} {
      allow read: if isAdmin() || isOwner(registrationId) ||
        (isAuthenticated() && resource.data.accountUid == request.auth.uid);
      allow create: if isOwner(registrationId) &&
        request.resource.data.accountUid == request.auth.uid &&
        request.resource.data.registrationType == 'student' &&
        request.resource.data.eventKey == 'puzzle-night-2026' &&
        request.resource.data.status == 'registered' &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.grade is string && request.resource.data.grade.size() > 0 &&
        request.resource.data.parentName is string && request.resource.data.parentName.size() > 0 &&
        request.resource.data.parentEmail is string && request.resource.data.parentEmail.size() > 0 &&
        getAfter(/databases/$(database)/documents/siteProfiles/$(request.auth.uid)).data.accountType == 'student';
      allow update, delete: if isAdmin();
    }

    match /dtmtCoachProfiles/{coachId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(coachId) || isAdmin();
    }

    match /dtmtSchools/{schoolId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(schoolId) || isAdmin();
    }

    match /dtmtStudentRegistrations/{studentId} {
      allow read: if isAdmin() ||
        (isAuthenticated() &&
          (
            resource.data.accountUid == request.auth.uid ||
            resource.data.schoolId == request.auth.uid
          ));

      allow create: if isAuthenticated() && request.resource.data.accountUid == request.auth.uid;

      allow update: if isAdmin() ||
        (isAuthenticated() &&
          (
            resource.data.accountUid == request.auth.uid ||
            resource.data.schoolId == request.auth.uid
          ));

      allow delete: if isOwner(studentId) || isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin() ||
        (isGrader() && resource.data.assignedGrader == request.auth.uid) ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.studentEmail == request.auth.token.email;
      allow update: if isAdmin() ||
        (isGrader() && resource.data.assignedGrader == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'q3Score', 'q3Feedback', 'gradingStatus', 'gradedBy',
            'gradedByName', 'humanGradedAt'
          ]));
    }

    match /activeTests/{testId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /schedule/{day} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/{setting} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if false;
    }

    match /DTMTClarifications/{clarificationId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }
  }
}
